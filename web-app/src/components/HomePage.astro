---
import { Image, getImage } from "astro:assets";
import { translations, type Language } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import ContactForm from "./ContactForm";
import LanguageSwitcher from "./LanguageSwitcher";
import gallery1 from "../assets/1.jpg";
import gallery2 from "../assets/2.jpg";
import gallery3 from "../assets/3.jpg";
import gallery4 from "../assets/4.jpg";
import gallery5 from "../assets/5.jpg";
import logo from "../assets/logo.png";

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const t = translations[lang];
const altLang = lang === "fr" ? "en" : "fr";
const altUrl = `/${altLang}/`;

const galleryImages = [
	{ src: gallery1, alt: t.galleryAlt1 },
	{ src: gallery2, alt: t.galleryAlt2 },
	{ src: gallery3, alt: t.galleryAlt3 },
	{ src: gallery4, alt: t.galleryAlt4 },
	{ src: gallery5, alt: t.galleryAlt5 },
];

const galleryItems = await Promise.all(
	galleryImages.map(async (item) => {
		const lightbox = await getImage({
			src: item.src,
			width: 2000,
			format: "webp",
			quality: 95,
		});
		return {
			alt: item.alt,
			thumb: item.src,
			lightboxSrc: lightbox.src,
			lightboxWidth: lightbox.attributes.width,
			lightboxHeight: lightbox.attributes.height,
		};
	}),
);
---

<Layout lang={lang}>
	<!-- Sticky Header -->
	<header
		class="fixed top-0 w-full bg-black text-white shadow-lg z-50 transition-all border-b-2 border-primary/40"
	>
		<div class="container mx-auto px-4 py-3 md:py-4">
			<div class="flex items-center justify-between">
				<!-- Logo/Company Name -->
				<a
					href="#top"
					class="flex items-center space-x-3 hover:opacity-90 transition-opacity"
				>
					<Image
						src={logo}
						alt={t.companyName}
						width={128}
						height={128}
						quality={90}
						format="webp"
						loading="eager"
						class="h-12 md:h-16 w-auto"
					/>
					<div class="flex-shrink-0 hidden sm:block">
						<h1 class="text-lg md:text-xl font-bold">
							{t.companyName}
						</h1>
						<p class="text-xs md:text-sm opacity-90">{t.rbq}</p>
					</div>
				</a>

				<!-- Contact & Language -->
				<div class="flex items-center gap-2 md:gap-4">
					<a
						href="tel:4503287008"
						class="hidden sm:flex items-center space-x-2 bg-white/10 hover:bg-secondary/30 px-3 md:px-4 py-2 rounded-lg transition-colors backdrop-blur-sm border border-white/10 hover:border-secondary/50"
					>
						<svg
							class="w-5 h-5"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<span class="font-semibold">{t.phone}</span>
					</a>
					<LanguageSwitcher lang={lang} client:load />
				</div>
			</div>
		</div>
	</header>

	<!-- Hero Section -->
	<section
		class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 via-gray-800 to-primary-800 text-white pt-20"
	>
		<!-- Background Pattern -->
		<div class="absolute inset-0 opacity-10">
			<div
				class="absolute inset-0"
				style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
			>
			</div>
		</div>

		<div class="container mx-auto px-4 py-16 md:py-24 relative z-10">
			<div class="max-w-4xl mx-auto text-center">
				<!-- Main Title -->
				<h2
					class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight"
				>
					{t.heroTitle}
				</h2>
				<p
					class="text-xl md:text-2xl text-secondary-200 font-semibold mb-4"
				>
					{t.heroSubtitle}
				</p>
				<p
					class="text-lg md:text-xl text-gray-200 mb-8 max-w-3xl mx-auto"
				>
					{t.heroDescription}
				</p>
				<p class="text-secondary-300 text-sm md:text-base mb-10">
					📍 {t.heroLocation}
				</p>

				<!-- CTA Buttons -->
				<div
					class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12"
				>
					<a
						href="tel:4503287008"
						class="group w-full sm:w-auto bg-secondary-600 hover:bg-secondary-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all shadow-xl hover:shadow-2xl hover:scale-105 flex items-center justify-center space-x-2"
					>
						<svg
							class="w-6 h-6"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<span>{t.callNow}</span>
					</a>
					<a
						href="#contact"
						class="w-full sm:w-auto bg-white hover:bg-gray-100 text-gray-900 px-8 py-4 rounded-lg font-bold text-lg transition-all shadow-xl hover:shadow-2xl hover:scale-105"
					>
						{t.bookAppointment}
					</a>
				</div>

				<!-- Quick Phone Display (Mobile) -->
				<div class="sm:hidden mt-8">
					<a
						href="tel:4503287008"
						class="text-2xl font-bold text-white hover:text-secondary-300 transition-colors flex items-center justify-center gap-3"
					>
						<svg
							class="w-8 h-8 text-secondary-400"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<span>{t.phone}</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div
			class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
		>
			<svg
				class="w-6 h-6 text-white"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
			</svg>
		</div>
	</section>

	<!-- About Section -->
	<section class="py-16 md:py-24 bg-white">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">
					{t.aboutTitle}
				</h2>
				<p class="text-lg md:text-xl text-gray-700 leading-relaxed">
					{t.aboutText}
				</p>
			</div>
		</div>
	</section>

	<!-- Values Section -->
	<section class="py-16 md:py-24 bg-gray-50">
		<div class="container mx-auto px-4">
			<h2
				class="text-3xl md:text-5xl font-bold text-center text-gray-900 mb-12"
			>
				{t.valuesTitle}
			</h2>
			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8"
			>
				<!-- Efficiency -->
				<div
					class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center"
				>
					<div
						class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-secondary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M13 10V3L4 14h7v7l9-11h-7z"></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">
						{t.valueEfficiency}
					</h3>
					<p class="text-gray-600">{t.valueEfficiencyDesc}</p>
				</div>

				<!-- Respect -->
				<div
					class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center"
				>
					<div
						class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-primary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">
						{t.valueRespect}
					</h3>
					<p class="text-gray-600">{t.valueRespectDesc}</p>
				</div>

				<!-- Trust -->
				<div
					class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center"
				>
					<div
						class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-secondary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">
						{t.valueTrust}
					</h3>
					<p class="text-gray-600">{t.valueTrustDesc}</p>
				</div>

				<!-- Quality -->
				<div
					class="bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow text-center"
				>
					<div
						class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-primary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900 mb-2">
						{t.valueQuality}
					</h3>
					<p class="text-gray-600">{t.valueQualityDesc}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Section -->
	<section class="py-16 md:py-24 bg-white">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
					{t.servicesTitle}
				</h2>
				<p class="text-xl text-gray-600">{t.servicesSubtitle}</p>
			</div>

			<div
				class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 max-w-5xl mx-auto"
			>
				{
					[
						{
							name: t.service1,
							icon: "M9 6 L6.5 3.5 a1.5 1.5 0 0 0 -1 -0.5 C4.683 3 4 3.683 4 4.5 V12 M10 5 L8 7 M2 12 H22 V14 a3 3 0 0 1 -3 3 H5 a3 3 0 0 1 -3 -3 Z M7 19 V21 M17 19 V21",
						},
						{
							name: t.service2,
							icon: "M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z",
						},
						{
							name: t.service3,
							icon: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
						},
						{
							name: t.service4,
							icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
						},
						{
							name: t.service6,
							icon: "M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z",
						},
						{
							name: t.service7,
							icon: "M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z",
						},
					].map((service, index) => (
						<div class="bg-gray-50 p-6 rounded-lg" key={index}>
							<svg
								class="w-10 h-10 text-secondary mb-3"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d={service.icon}
								/>
							</svg>
							<h3 class="font-semibold text-gray-900 text-lg">
								{service.name}
							</h3>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Contact Form Section -->
	<section
		id="contact"
		class="py-16 md:py-24 bg-gradient-to-br from-primary-50 to-gray-50"
	>
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
					{t.formTitle}
				</h2>
				<p class="text-xl text-gray-600">{t.formSubtitle}</p>
			</div>
			<ContactForm lang={lang} client:load />
		</div>
	</section>

	<!-- Certifications Section -->
	<section class="py-16 md:py-24 bg-white">
		<div class="container mx-auto px-4">
			<h2
				class="text-3xl md:text-5xl font-bold text-center text-gray-900 mb-12"
			>
				{t.certificationsTitle}
			</h2>
			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto"
			>
				<div class="text-center p-6 bg-gray-50 rounded-lg">
					<div
						class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-secondary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
							></path>
						</svg>
					</div>
					<h3 class="font-bold text-gray-900">{t.cert1}</h3>
				</div>
				<div class="text-center p-6 bg-gray-50 rounded-lg">
					<div
						class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-secondary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
							></path>
						</svg>
					</div>
					<h3 class="font-bold text-gray-900">{t.cert2}</h3>
				</div>
				<div class="text-center p-6 bg-gray-50 rounded-lg">
					<div
						class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-secondary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
							></path>
						</svg>
					</div>
					<h3 class="font-bold text-gray-900">{t.cert3}</h3>
				</div>
				<div class="text-center p-6 bg-gray-50 rounded-lg">
					<div
						class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<svg
							class="w-8 h-8 text-primary"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
							></path>
						</svg>
					</div>
					<h3 class="font-bold text-gray-900">{t.cert4}</h3>
				</div>
			</div>
		</div>
	</section>

	<!-- Gallery Section -->
	<section class="py-16 md:py-24 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4">
					{t.galleryTitle}
				</h2>
				<p class="text-xl text-gray-600">{t.gallerySubtitle}</p>
			</div>
			<div
				id="gallery"
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6"
			>
				{
					galleryItems.map((item, idx) => (
						<div
							class="aspect-video md:aspect-square bg-gray-200 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow group"
							key={idx}
						>
							<a
								href={item.lightboxSrc}
								data-pswp-width={item.lightboxWidth}
								data-pswp-height={item.lightboxHeight}
								class="block w-full h-full cursor-zoom-in"
							>
								<Image
									src={item.thumb}
									alt={item.alt}
									widths={[600, 900, 1200, 1600]}
									sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
									quality={95}
									format="webp"
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-105 transition-transform"
								/>
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-neutral-900 text-white py-12 md:py-16">
		<div class="container mx-auto px-4">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
