					<p class="text-gray-400 mb-2">{t.rbq}</p>
					<p class="text-gray-400">{t.footerTagline}</p>
				</div>

				<!-- Contact -->
				<div>
					<h3 class="text-xl font-bold mb-4">{t.footerContact}</h3>
					<a
						href="tel:4503287008"
						class="text-primary-300 hover:text-secondary-400 text-lg font-semibold flex items-center gap-2 mb-2 group"
					>
						<svg
							class="w-5 h-5 text-secondary-400 group-hover:text-secondary-300"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
							></path>
						</svg>
						<span>{t.phone}</span>
					</a>
					<p class="text-gray-400 text-sm">{t.heroLocation}</p>
				</div>

				<!-- Social Media -->
				<div>
					<h3 class="text-xl font-bold mb-4">{t.footerFollow}</h3>
					<div class="flex space-x-4">
						<a
							href="https://www.facebook.com/profile.php?id=61589421523150"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Facebook"
							class="w-10 h-10 bg-white/10 hover:bg-secondary/30 border border-white/10 hover:border-secondary/50 rounded-full flex items-center justify-center transition-colors"
						>
							<svg
								class="w-5 h-5"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
								></path>
							</svg>
						</a>
					</div>
				</div>
			</div>

			<div
				class="border-t border-gray-800 pt-8 text-center text-gray-400 text-sm"
			>
				<p>
					&copy; {new Date().getFullYear()}
					{t.companyLegalName}
					{t.footerRights}
				</p>
			</div>
		</div>
	</footer>

	<script>
		import PhotoSwipeLightbox from "photoswipe/lightbox";
		import "photoswipe/style.css";

		const lightbox = new PhotoSwipeLightbox({
			gallery: "#gallery",
			children: "a[data-pswp-width]",
			pswpModule: () => import("photoswipe"),
		});
		lightbox.init();
	</script>
</Layout>
